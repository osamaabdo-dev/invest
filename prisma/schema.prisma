generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AssetType {
  GOLD
  STOCK
  CASH
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
}

model Asset {
  id              String        @id @default(cuid())
  type            AssetType
  symbol          String
  name            String
  currency        String        @default("EGP")
  metadata        Json?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  transactions    Transaction[]
  priceHistory    PriceHistory[]

  @@unique([type, symbol])
}

model Transaction {
  id              String          @id @default(cuid())
  assetId          String
  asset            Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type             TransactionType
  quantity         Decimal         @db.Decimal(18, 6)
  pricePerUnit     Decimal         @db.Decimal(18, 6)
  fees             Decimal         @default(0) @db.Decimal(18, 6)
  totalValue       Decimal         @db.Decimal(18, 6)
  executedAt       DateTime
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([assetId, executedAt])
}

model PriceHistory {
  id               String         @id @default(cuid())
  assetId           String
  asset             Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  price             Decimal        @db.Decimal(18, 6)
  currency          String         @default("EGP")
  source            String
  observedAt        DateTime

  @@index([assetId, observedAt])
}

model PortfolioSnapshot {
  id                String         @id @default(cuid())
  snapshotAt        DateTime
  totalValue        Decimal        @db.Decimal(18, 6)
  cashValue         Decimal        @db.Decimal(18, 6)
  goldValue         Decimal        @db.Decimal(18, 6)
  stocksValue       Decimal        @db.Decimal(18, 6)
  metadata          Json?

  @@index([snapshotAt])
}

model MonthlyReport {
  id                String         @id @default(cuid())
  month             String         @unique
  startValue        Decimal        @db.Decimal(18, 6)
  endValue          Decimal        @db.Decimal(18, 6)
  netCashFlows      Decimal        @db.Decimal(18, 6)
  realizedPnL       Decimal        @db.Decimal(18, 6)
  unrealizedPnL     Decimal        @db.Decimal(18, 6)
  reportData        Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model SyncStatus {
  id                String          @id @default(cuid())
  key               String          @unique
  lastSuccessAt     DateTime?
  lastError         String?
  retryCount        Int             @default(0)
  updatedAt         DateTime        @updatedAt
}

model AppSetting {
  id                 String         @id @default(cuid())
  key                String         @unique
  value              String
  updatedAt          DateTime       @updatedAt
}
